<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Teruskan aset statis (/assets/ & /uploads/) langsung ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # 2. Teruskan semua request lain ke Laravel Front Controller (public/index.php)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
