<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Teruskan aset statis dari /assets/ ke public/assets/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # 2. Teruskan semua request ke Laravel Front Controller (public/index.php)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
